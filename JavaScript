<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>facebook-clone</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --fb-blue:#1877F2;
    --fb-blue-dark:#166FE5;
    --bg:#F0F2F5;
    --card:#FFFFFF;
    --text:#050505;
    --muted:#65676B;
    --border:#DDDFE2;
  }
  *{box-sizing:border-box;}
  button{
    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;
    user-select:none;
    -webkit-user-select:none;
  }
  button:active{
    transform:scale(0.97);
  }
  body{
    margin:0;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
  }
  header{
    background:var(--card);
    border-bottom:1px solid var(--border);
    padding:10px 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    position:sticky;
    top:0;
    z-index:10;
  }
  header h1{
    color:var(--fb-blue);
    font-size:26px;
    margin:0;
    letter-spacing:-0.5px;
  }
  header button{
    background:none;
    border:none;
    color:var(--muted);
    font-weight:600;
    cursor:pointer;
    font-size:14px;
    min-height:44px;
    padding:0 12px;
    border-radius:6px;
  }
  header button:active{
    background:var(--bg);
  }
  .hidden{display:none !important;}

  /* ---- AUTH SCREEN ---- */
  #auth-screen{
    max-width:400px;
    margin:40px auto;
    padding:0 16px;
  }
  #auth-screen .logo{
    text-align:center;
    color:var(--fb-blue);
    font-size:56px;
    font-weight:800;
    margin-bottom:24px;
    letter-spacing:-1.5px;
  }
  .auth-card{
    background:var(--card);
    border-radius:12px;
    box-shadow:0 2px 8px rgba(0,0,0,0.1);
    padding:20px;
  }
  .tabs{
    display:flex;
    gap:6px;
    margin-bottom:16px;
    border-bottom:1px solid var(--border);
    padding-bottom:12px;
  }
  .tab-btn{
    border:none;
    background:var(--bg);
    color:var(--text);
    padding:10px 14px;
    min-height:44px;
    border-radius:6px;
    font-weight:600;
    font-size:14px;
    cursor:pointer;
    transition:background 0.15s;
  }
  .tab-btn.active{
    background:var(--fb-blue);
    color:#fff;
  }
  .auth-form{display:none;flex-direction:column;gap:10px;}
  .auth-form.active{display:flex;}
  .demo-box{
    background:var(--bg);
    border-radius:8px;
    padding:12px 14px;
    font-size:13.5px;
    color:var(--text);
    line-height:1.6;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  input{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:6px;
    font-size:15px;
  }
  input:focus{outline:2px solid var(--fb-blue);border-color:transparent;}
  .btn-primary{
    background:var(--fb-blue);
    color:#fff;
    border:none;
    padding:12px;
    min-height:48px;
    border-radius:6px;
    font-size:17px;
    font-weight:700;
    cursor:pointer;
    width:100%;
    transition:background 0.15s;
  }
  .btn-primary:hover{background:var(--fb-blue-dark);}
  .btn-primary:active:not(:disabled){background:var(--fb-blue-dark);}
  .btn-primary:disabled{opacity:0.6;cursor:default;}
  .auth-msg{
    font-size:13px;
    padding:8px 10px;
    border-radius:6px;
    margin-top:4px;
  }
  .auth-msg.error{background:#FDECEA;color:#C0392B;}
  .auth-msg.success{background:#EAF7EE;color:#1E7A34;}
  .config-banner{
    background:#FFF4E5;
    color:#8A5300;
    border:1px solid #F5C97B;
    border-radius:8px;
    padding:12px 14px;
    font-size:13.5px;
    line-height:1.5;
    margin-bottom:16px;
    max-width:400px;
    margin-left:auto;
    margin-right:auto;
  }

  /* ---- FEED ---- */
  #feed-screen{
    max-width:560px;
    margin:20px auto;
    padding:0 16px 60px;
  }
  .composer{
    background:var(--card);
    border-radius:10px;
    box-shadow:0 1px 2px rgba(0,0,0,0.15);
    padding:14px;
    margin-bottom:16px;
  }
  .composer textarea{
    width:100%;
    border:none;
    resize:none;
    font-size:16px;
    min-height:50px;
    font-family:inherit;
    padding:8px 0;
  }
  .composer textarea:focus{outline:none;}
  .composer-actions{
    display:flex;
    justify-content:flex-end;
    border-top:1px solid var(--border);
    padding-top:10px;
    margin-top:6px;
  }
  .composer-actions button{
    background:var(--fb-blue);
    color:#fff;
    border:none;
    padding:8px 22px;
    min-height:44px;
    border-radius:6px;
    font-weight:700;
    cursor:pointer;
    transition:background 0.15s;
  }
  .composer-actions button:active:not(:disabled){background:var(--fb-blue-dark);}
  .composer-actions button:disabled{opacity:0.5;}

  .post{
    background:var(--card);
    border-radius:10px;
    box-shadow:0 1px 2px rgba(0,0,0,0.15);
    padding:14px;
    margin-bottom:16px;
  }
  .post-head{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:10px;
  }
  .avatar{
    width:40px;height:40px;border-radius:50%;
    background:var(--fb-blue);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-weight:700;
    flex-shrink:0;
  }
  .post-author{font-weight:600;font-size:14.5px;}
  .post-time{font-size:12px;color:var(--muted);}
  .post-content{font-size:15px;line-height:1.4;white-space:pre-wrap;}
  .post-footer{
    display:flex;
    gap:16px;
    border-top:1px solid var(--border);
    margin-top:10px;
    padding-top:8px;
  }
  .like-btn{
    background:none;border:none;cursor:pointer;
    color:var(--muted);font-weight:600;font-size:13.5px;
    display:flex;align-items:center;gap:6px;
    min-height:44px;
    padding:0 10px;
    border-radius:6px;
    transition:background 0.15s;
  }
  .like-btn:active:not(:disabled){background:var(--bg);}
  .like-btn:disabled{opacity:0.6;cursor:default;}
  .like-btn.liked{color:var(--fb-blue);}
  .empty-state{
    text-align:center;
    color:var(--muted);
    padding:40px 10px;
    font-size:14px;
  }
  .loading{
    text-align:center;
    color:var(--muted);
    padding:20px;
    font-size:14px;
  }
</style>
</head>
<body>

<!-- ============ AUTH SCREEN ============ -->
<div id="auth-screen">
  <div class="logo">facebook</div>
  <div id="config-banner" class="config-banner hidden">
    ⚠️ Configurazione mancante: apri il file HTML, cerca <code>SUPABASE_URL</code> e <code>SUPABASE_ANON_KEY</code> nello script e sostituiscili con i valori del tuo progetto (Project Settings → API su supabase.com).
  </div>
  <div class="auth-card">
    <div class="tabs">
      <button class="tab-btn active" data-tab="login">Accedi</button>
      <button class="tab-btn" data-tab="signup">Registrati</button>
      <button class="tab-btn" data-tab="reset">Password dimenticata</button>
    </div>

    <!-- LOGIN -->
    <form class="auth-form active" id="login-form">
      <div class="demo-box">
        Account demo pronti all'uso:<br/>
        marco@demo.it&nbsp;/&nbsp;demo123<br/>
        giulia@demo.it&nbsp;/&nbsp;demo123
      </div>
      <input type="email" id="login-email" placeholder="Email" required autocomplete="email" />
      <input type="password" id="login-password" placeholder="Password" required autocomplete="current-password" />
      <button class="btn-primary" type="submit">Accedi</button>
      <div class="auth-msg hidden" id="login-msg"></div>
    </form>

    <!-- SIGNUP -->
    <form class="auth-form" id="signup-form">
      <input type="text" id="signup-name" placeholder="Nome e cognome" required />
      <input type="email" id="signup-email" placeholder="Email" required autocomplete="email" />
      <input type="password" id="signup-password" placeholder="Password (min. 6 caratteri)" required minlength="6" autocomplete="new-password" />
      <button class="btn-primary" type="submit">Crea account</button>
      <div class="auth-msg hidden" id="signup-msg"></div>
    </form>

    <!-- RESET -->
    <form class="auth-form" id="reset-form">
      <input type="email" id="reset-email" placeholder="Inserisci la tua email" required />
      <button class="btn-primary" type="submit">Invia link di reset</button>
      <div class="auth-msg hidden" id="reset-msg"></div>
    </form>
  </div>
</div>

<!-- ============ FEED SCREEN ============ -->
<div id="feed-screen" class="hidden">
  <header>
    <h1>facebook</h1>
    <button id="logout-btn">Esci</button>
  </header>

  <div style="max-width:560px;margin:16px auto 0;padding:0 16px;">
    <div class="composer">
      <textarea id="post-content" placeholder="A cosa stai pensando?"></textarea>
      <div class="composer-actions">
        <button id="publish-btn">Pubblica</button>
      </div>
    </div>

    <div id="posts-list">
      <div class="loading">Caricamento post...</div>
    </div>
  </div>
</div>

<script>
/* =========================================================
   CONFIGURAZIONE SUPABASE
   Sostituisci questi due valori con quelli del tuo progetto:
   Project Settings → API → Project URL / anon public key
   ========================================================= */
const SUPABASE_URL = "https://TUO-PROGETTO.supabase.co";
const SUPABASE_ANON_KEY = "TUA-CHIAVE-ANON-PUBLIC";

const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

if(SUPABASE_URL.includes("TUO-PROGETTO") || SUPABASE_ANON_KEY.includes("TUA-CHIAVE")){
  document.getElementById("config-banner").classList.remove("hidden");
}

let currentUser = null;

// ---------- UI helpers ----------
function showMsg(elId, text, type){
  const el = document.getElementById(elId);
  el.textContent = text;
  el.className = "auth-msg " + type;
}
function clearMsg(elId){
  const el = document.getElementById(elId);
  el.className = "auth-msg hidden";
}
function escapeHtml(str){
  const div = document.createElement("div");
  div.textContent = str;
  return div.innerHTML;
}
function timeAgo(dateStr){
  const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
  if(diff < 60) return "adesso";
  if(diff < 3600) return Math.floor(diff/60) + " min fa";
  if(diff < 86400) return Math.floor(diff/3600) + " h fa";
  return Math.floor(diff/86400) + " g fa";
}
function initials(name){
  return (name || "?").trim().split(" ").map(p=>p[0]).slice(0,2).join("").toUpperCase();
}

// ---------- Guard anti doppio-click sui form ----------
document.querySelectorAll("form").forEach(form=>{
  form.addEventListener("submit", ()=>{
    const btn = form.querySelector("button[type=submit], button");
    if(btn) btn.disabled = true;
  });
});

// ---------- Tabs ----------
document.querySelectorAll(".tab-btn").forEach(btn=>{
  btn.addEventListener("click", ()=>{
    document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active"));
    document.querySelectorAll(".auth-form").forEach(f=>f.classList.remove("active"));
    btn.classList.add("active");
    document.getElementById(btn.dataset.tab + "-form").classList.add("active");
  });
});

// ---------- Screen switch ----------
function showFeed(){
  document.getElementById("auth-screen").classList.add("hidden");
  document.getElementById("feed-screen").classList.remove("hidden");
  loadPosts();
}
function showAuth(){
  document.getElementById("feed-screen").classList.add("hidden");
  document.getElementById("auth-screen").classList.remove("hidden");
}

// ---------- SIGNUP ----------
document.getElementById("signup-form").addEventListener("submit", async (e)=>{
  e.preventDefault();
  clearMsg("signup-msg");
  const name = document.getElementById("signup-name").value.trim();
  const email = document.getElementById("signup-email").value.trim();
  const password = document.getElementById("signup-password").value;
  const btn = e.target.querySelector("button");
  btn.disabled = true;

  try{
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: { data: { full_name: name } }
    });

    if(error){
      showMsg("signup-msg", error.message, "error");
      return;
    }

    // Crea/aggiorna il profilo pubblico nella tabella "profiles"
    if(data.user){
      await supabase.from("profiles").upsert({
        id: data.user.id,
        full_name: name,
        email: email
      });
    }

    if(data.session){
      // Conferma email disattivata: sessione subito attiva
      currentUser = data.user;
      showFeed();
    } else {
      showMsg("signup-msg", "Registrazione avvenuta! Controlla la tua email per confermare l'account.", "success");
    }
  } catch(err){
    showMsg("signup-msg", "Impossibile contattare Supabase. Controlla di aver inserito URL e chiave corretti nel codice.", "error");
  } finally {
    btn.disabled = false;
  }
});

// ---------- LOGIN ----------
document.getElementById("login-form").addEventListener("submit", async (e)=>{
  e.preventDefault();
  clearMsg("login-msg");
  const email = document.getElementById("login-email").value.trim();
  const password = document.getElementById("login-password").value;
  const btn = e.target.querySelector("button");
  btn.disabled = true;

  try{
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });

    if(error){
      showMsg("login-msg", error.message === "Invalid login credentials" ? "Email o password non corrette." : error.message, "error");
      return;
    }
    currentUser = data.user;
    showFeed();
  } catch(err){
    showMsg("login-msg", "Impossibile contattare Supabase. Controlla di aver inserito URL e chiave corretti nel codice.", "error");
  } finally {
    btn.disabled = false;
  }
});

// ---------- PASSWORD RESET ----------
document.getElementById("reset-form").addEventListener("submit", async (e)=>{
  e.preventDefault();
  clearMsg("reset-msg");
  const email = document.getElementById("reset-email").value.trim();
  const btn = e.target.querySelector("button");
  btn.disabled = true;

  try{
    const { error } = await supabase.auth.resetPasswordForEmail(email);

    if(error){
      showMsg("reset-msg", error.message, "error");
      return;
    }
    showMsg("reset-msg", "Se l'indirizzo esiste, riceverai un'email con le istruzioni.", "success");
  } catch(err){
    showMsg("reset-msg", "Impossibile contattare Supabase. Controlla di aver inserito URL e chiave corretti nel codice.", "error");
  } finally {
    btn.disabled = false;
  }
});

// ---------- LOGOUT ----------
document.getElementById("logout-btn").addEventListener("click", async ()=>{
  const btn = document.getElementById("logout-btn");
  if(btn.disabled) return;
  btn.disabled = true;
  await supabase.auth.signOut();
  currentUser = null;
  btn.disabled = false;
  showAuth();
});

// ---------- PUBLISH POST ----------
document.getElementById("publish-btn").addEventListener("click", async ()=>{
  const btn = document.getElementById("publish-btn");
  if(btn.disabled) return;
  const textarea = document.getElementById("post-content");
  const content = textarea.value.trim();
  if(!content || !currentUser) return;

  btn.disabled = true;

  const { error } = await supabase.from("posts").insert({
    user_id: currentUser.id,
    content: content
  });

  btn.disabled = false;

  if(error){
    alert("Errore nella pubblicazione: " + error.message);
    return;
  }
  textarea.value = "";
  loadPosts();
});

// ---------- LOAD POSTS (feed) ----------
async function loadPosts(){
  const list = document.getElementById("posts-list");
  list.innerHTML = '<div class="loading">Caricamento post...</div>';

  const { data: posts, error } = await supabase
    .from("posts")
    .select("id, content, created_at, user_id, profiles(full_name), likes(user_id)")
    .order("created_at", { ascending: false });

  if(error){
    list.innerHTML = '<div class="empty-state">Errore nel caricamento: ' + escapeHtml(error.message) + '</div>';
    return;
  }

  if(!posts || posts.length === 0){
    list.innerHTML = '<div class="empty-state">Nessun post ancora. Scrivi il primo!</div>';
    return;
  }

  list.innerHTML = posts.map(p=>{
    const authorName = p.profiles?.full_name || "Utente";
    const likeCount = p.likes ? p.likes.length : 0;
    const likedByMe = p.likes ? p.likes.some(l=>l.user_id === currentUser.id) : false;
    return `
      <div class="post" data-post-id="${p.id}">
        <div class="post-head">
          <div class="avatar">${escapeHtml(initials(authorName))}</div>
          <div>
            <div class="post-author">${escapeHtml(authorName)}</div>
            <div class="post-time">${timeAgo(p.created_at)}</div>
          </div>
        </div>
        <div class="post-content">${escapeHtml(p.content)}</div>
        <div class="post-footer">
          <button class="like-btn ${likedByMe ? "liked" : ""}" data-liked="${likedByMe}" data-post-id="${p.id}">
            👍 <span class="like-count">${likeCount}</span> Mi piace
          </button>
        </div>
      </div>
    `;
  }).join("");

  document.querySelectorAll(".like-btn").forEach(btn=>{
    btn.addEventListener("click", ()=>toggleLike(btn));
  });
}

// ---------- LIKE / UNLIKE ----------
async function toggleLike(btn){
  if(btn.disabled) return;
  const postId = btn.dataset.postId;
  const liked = btn.dataset.liked === "true";
  btn.disabled = true;

  if(liked){
    await supabase.from("likes").delete()
      .eq("post_id", postId)
      .eq("user_id", currentUser.id);
  } else {
    await supabase.from("likes").insert({ post_id: postId, user_id: currentUser.id });
  }

  btn.disabled = false;
  loadPosts();
}

// ---------- SESSIONE ESISTENTE ----------
(async ()=>{
  const { data } = await supabase.auth.getSession();
  if(data.session){
    currentUser = data.session.user;
    showFeed();
  }
})();

supabase.auth.onAuthStateChange((event, session)=>{
  if(session) currentUser = session.user;
});
</script>
</body>
</html>

